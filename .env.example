# 芝语：后续 Next.js 版本的配置模板。用于本项目的服务接入。
# 复制为 .env.local 后在本地填值；上线时填入 Vercel Environment Variables。
# 此文件可放已确认的公开配置，不放真实密钥。

# Supabase：直接使用 Vercel 的 zhiyu 集成变量名，大小写须一致。
# 集成已自动注入时无需重复创建或改名。
NEXT_PUBLIC_zhiyu_SUPABASE_URL=https://mgbahqnxoraqmljibsrc.supabase.co
NEXT_PUBLIC_zhiyu_SUPABASE_PUBLISHABLE_KEY=
# 兼容同一集成的 anon；非空 publishable 优先
NEXT_PUBLIC_zhiyu_SUPABASE_ANON_KEY=

# 仅服务端；非空 secret 优先，否则使用同一集成的 service_role
zhiyu_SUPABASE_SECRET_KEY=
zhiyu_SUPABASE_SERVICE_ROLE_KEY=

# 已有无 zhiyu 前缀的旧配置仍可回退使用，无需复制两套。
# 本项目使用 Supabase HTTP API，不读取 zhiyu_POSTGRES_* 或 JWT_SECRET。

# Supabase Authentication 中指定管理员账号的 User UID
ADMIN_USER_ID=

# Cloudflare R2：账号、对象读写凭据、桶名称（凭据仅服务端使用）
R2_ACCOUNT_ID=1b78820da96cc4165361c9f7be4d3099
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=blog
R2_KEY_PREFIX=blob

# R2 Public Development URL，示例：https://pub-xxx.r2.dev
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-d631369681144c86b273231bd9377fe0.r2.dev

# 本地开发用 localhost；Vercel 部署后改为网站的 HTTPS 地址
NEXT_PUBLIC_SITE_URL=http://localhost:3000
