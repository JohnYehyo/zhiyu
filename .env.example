# 芝语：后续 Next.js 版本的配置模板。用于本项目的服务接入。
# 复制为 .env.local 后在本地填值；上线时填入 Vercel Environment Variables。
# 此文件只放变量名和空值，不放真实密钥。

# Supabase：Project URL 与 Publishable key（前端可使用）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase：仅服务端使用的 Secret key
SUPABASE_SECRET_KEY=

# Supabase Authentication 中指定管理员账号的 User UID
ADMIN_USER_ID=

# Cloudflare R2：账号、对象读写凭据、桶名称（凭据仅服务端使用）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_KEY_PREFIX=blob

# R2 Public Development URL，示例：https://pub-xxx.r2.dev
NEXT_PUBLIC_MEDIA_BASE_URL=

# 本地开发用 localhost；Vercel 部署后改为网站的 HTTPS 地址
NEXT_PUBLIC_SITE_URL=http://localhost:3000
